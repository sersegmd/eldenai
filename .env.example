# ================= ELDEN AI CONFIG =================
# Never publish this file or commit real secrets.
BOT_TOKEN=PASTE_TELEGRAM_BOT_TOKEN_HERE
ADMIN_TELEGRAM_IDS=8462511068

# OpenRouter language model with reasoning
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=PASTE_OPENROUTER_API_KEY_HERE
OPENROUTER_MODEL=thinkingmachines/inkling:free
OPENROUTER_TIMEOUT=240
OPENROUTER_SITE_URL=

# Agnes Video Generator must be running separately on this address
AGNES_BASE_URL=http://127.0.0.1:8765
AGNES_AUTO_START=true
AGNES_START_COMMAND=npx free-short-video --no-open
AGNES_PROJECT_DIR=
AGNES_POLL_SECONDS=10
AGNES_TASK_TIMEOUT=3600
AGNES_DOWNLOAD_TIMEOUT=120
AGNES_DOWNLOAD_RETRIES=12
AGNES_STATUS_TIMEOUT=90
TELEGRAM_VIDEO_MAX_MB=49
TELEGRAM_RETRY_SECONDS=15

# Local OpenAI Whisper service (started automatically)
WHISPER_BASE_URL=http://127.0.0.1:8766
WHISPER_MODEL=small
WHISPER_TIMEOUT=600
MAX_VOICE_SECONDS=180
WHISPER_MIN_CONFIDENCE=0.55

# Fish Audio voice replies (choose a voice at fish.audio and copy its model/reference ID)
FISH_AUDIO_BASE_URL=https://api.fish.audio
FISH_AUDIO_API_KEY=PASTE_FISH_AUDIO_API_KEY_HERE
FISH_AUDIO_REFERENCE_ID=PASTE_FISH_AUDIO_VOICE_ID_HERE
FISH_VOICE_MALE=
FISH_VOICE_FEMALE=
FISH_VOICE_AR=
FISH_VOICE_FR=
FISH_VOICE_EN=
FISH_VOICE_NEWS_AR=
FISH_VOICE_NEWS_FR=
FISH_VOICE_NEWS_EN=
FISH_VOICE_DOCUMENTARY_AR=
FISH_VOICE_DOCUMENTARY_FR=
FISH_VOICE_DOCUMENTARY_EN=
FISH_VOICE_STORYTELLER_AR=
FISH_VOICE_STORYTELLER_FR=
FISH_VOICE_STORYTELLER_EN=
FISH_VOICE_ANIME_STORYTELLER_AR=
FISH_VOICE_ANIME_STORYTELLER_FR=
FISH_VOICE_ANIME_STORYTELLER_EN=
FISH_AUDIO_MODEL=s2.1-pro
FISH_AUDIO_FALLBACK_MODEL=s2.1-pro-free
FISH_AUDIO_TIMEOUT=180
FISH_AUDIO_MAX_CHARS=3000
FISH_AUDIO_LATENCY=balanced
FISH_AUDIO_CHUNK_LENGTH=120

# Image generation backend is intentionally disabled; /image is UI-only.
FREE_IMAGE_DAILY_LIMIT=20
PRO_IMAGE_DAILY_LIMIT=250
VIP_IMAGE_DAILY_LIMIT=1000
REFERRAL_INVITER_IMAGE_BONUS=5
REFERRAL_NEW_USER_IMAGE_BONUS=2

# Telegram Stars (XTR)
PRO_PRICE_STARS=500
VIP_PRICE_STARS=1000
PRO_DAILY_LIMIT=300
VIP_DAILY_LIMIT=2000
FREE_DAILY_LIMIT=100
FREE_VIDEO_DAILY_LIMIT=20
PRO_VIDEO_DAILY_LIMIT=60
VIP_VIDEO_DAILY_LIMIT=200
SUBSCRIPTION_DAYS=30

# Web dashboard
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8080
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=CHANGE_THIS_LONG_PASSWORD

# Privacy/security
# Kept only for compatibility with older versions; phone verification is disabled.
PHONE_HASH_SECRET=unused
SESSION_TTL_MINUTES=60
MAX_CONTEXT_MESSAGES=20
RATE_LIMIT_PER_MINUTE=8
DATABASE_PATH=elden_ai.db
LOG_LEVEL=INFO

# Advanced Creator
CREATOR_MAX_DURATION=60
CREATOR_MAX_SCENES=12
CREATOR_IMAGE_PARALLELISM=3
CREATOR_DEFAULT_MODE=balanced
AGNES_ANIMATION_CONCURRENCY=2
CREATOR_SCENE_ANIMATION_TIMEOUT=1200
CREATOR_CLIP_CACHE_SECONDS=3600
CAPTION_FONT_NAME=Tahoma
# Optional full path to your Arabic TTF/OTF file
CAPTION_FONT_FILE=
CAPTION_PRIMARY_COLOR=&H00FFFFFF
CAPTION_HIGHLIGHT_COLOR=&H0000D7FF
CREATOR_VIDEO_ENCODER=auto
CREATOR_MUSIC_DIR=assets/music
CREATOR_MUSIC_VOLUME=0.14

# Reliability and optional intelligence router
# true = keep only the main bot terminal visible; false = show every service terminal
HIDE_SERVICE_WINDOWS=true
CREATOR_CONCURRENCY=1
IMAGE_CONCURRENCY=2
TTS_CONCURRENCY=2
MUSIC_CONCURRENCY=1
UPLOAD_CONCURRENCY=2
TELEGRAM_UPLOAD_TIMEOUT=900
DELIVERY_RETENTION_SECONDS=3600
DELIVERY_RETRY_SECONDS=60
OUTPUT_DIR=data/outputs
PUTER_ENABLED=false
PUTER_MODE=fallback
PUTER_AUTH_TOKEN=
PUTER_MODEL=gpt-5.4-nano
PUTER_PORT=8770
PUTER_BASE_URL=http://127.0.0.1:8770
PUTER_TIMEOUT=180
